rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Field boleh tidak ada atau null (mis. akun tanpa foto), tapi kalau ada harus string dengan panjang terbatas.
    function okStr(d, k, n) {
      return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= n);
    }
    // Paket 21: id lagu YouTube (11 karakter) ATAU id SoundCloud yang di-encode (awalan "sc", lihat
    // Backend.isSoundCloud) — dipakai gantiin pengecekan lama yang maksa persis 11 karakter (nolak SoundCloud).
    function okId(d, k) {
      return k in d && d[k] is string
        && (d[k].matches('^[A-Za-z0-9_-]{11}$') || d[k].matches('^sc[A-Za-z0-9_-]{4,500}$'));
    }
    match /users/{u} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == u;
      match /friends/{f} {
        allow read: if request.auth.uid == u;
        allow create: if request.auth.uid == u
          || (request.auth.uid == f && exists(/databases/$(db)/documents/reqs/$(f + '_' + u)));
        allow update: if request.auth.uid == u;
        allow delete: if request.auth.uid == u || request.auth.uid == f;
      }
      match /inbox/{i} {
        allow read, delete: if request.auth.uid == u;
        // Hanya field yang benar-benar dikirim aplikasi (sendTo / sendReact), dengan batas panjang.
        allow create: if request.auth.uid == request.resource.data.from
          && request.resource.data.keys().hasOnly(['from', 'name', 'photo', 'tid', 'title', 'author', 'ts', 'react'])
          && okId(request.resource.data, 'tid')
          && okStr(request.resource.data, 'title', 200)
          && okStr(request.resource.data, 'author', 120)
          && okStr(request.resource.data, 'name', 80)
          && okStr(request.resource.data, 'photo', 500)
          && okStr(request.resource.data, 'react', 20)
          && exists(/databases/$(db)/documents/users/$(u)/friends/$(request.auth.uid));
      }
      match /colists/{c} {
        allow read, delete: if request.auth.uid == u;
        allow create, update: if request.auth.uid == u
          || (request.auth.uid == request.resource.data.owner
              && exists(/databases/$(db)/documents/users/$(u)/friends/$(request.auth.uid)));
      }
    }
    match /reqs/{id} {
      allow read: if request.auth.uid == resource.data.to || request.auth.uid == resource.data.from;
      allow create: if request.auth.uid == request.resource.data.from;
      allow update: if request.auth.uid == resource.data.from;
      allow delete: if request.auth.uid == resource.data.to || request.auth.uid == resource.data.from;
    }
    match /sync/{u} {
      allow read, write: if request.auth.uid == u;
    }
    match /colists/{c} {
      allow read: if request.auth.uid in resource.data.members;
      allow create: if request.auth.uid == request.resource.data.owner
        && request.auth.uid in request.resource.data.members;
      allow update, delete: if request.auth.uid == resource.data.owner;
      match /tracks/{t} {
        allow read, write: if request.auth.uid in get(/databases/$(db)/documents/colists/$(c)).data.members;
      }
    }
    // Paket 21: room dengar bareng TERBUKA buat siapa pun yang login Google (beda dari colists di atas yang
    // mewajibkan pertemanan). Cuma host yang boleh ganti lagu/status putar; anggota lain cuma boleh sentuh
    // entri dirinya sendiri di "members" (gabung/keluar/perbarui kehadiran) — gak bisa nyolong kontrol atau
    // ngerusak field lain. Host gak bisa diganti lewat update (cuma lewat delete+create ulang).
    match /rooms/{r} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.host
        && request.resource.data.keys().hasOnly(['host', 'hostName', 'name', 'trackId', 'title', 'author', 'posMs', 'playing', 'updatedAt', 'members', 'active'])
        && okStr(request.resource.data, 'name', 60)
        && okStr(request.resource.data, 'hostName', 80)
        && okId(request.resource.data, 'trackId')
        && okStr(request.resource.data, 'title', 200)
        && okStr(request.resource.data, 'author', 120)
        && request.resource.data.members is map
        && request.resource.data.members.size() <= 1
        && request.resource.data.active == true;
      allow update: if resource.data.host == request.resource.data.host
        && request.resource.data.keys().hasOnly(['host', 'hostName', 'name', 'trackId', 'title', 'author', 'posMs', 'playing', 'updatedAt', 'members', 'active'])
        && request.resource.data.members is map
        && request.resource.data.members.size() <= 30
        && (
          request.auth.uid == resource.data.host
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
              && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]))
        );
      allow delete: if request.auth.uid == resource.data.host;
    }
  }
}
